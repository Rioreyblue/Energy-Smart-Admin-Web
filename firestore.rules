rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    function requestIncludesUser(participants) {
      return isSignedIn() &&
        participants is list &&
        (participants.hasAny([request.auth.uid]));
    }

    function chatParticipantsIncludeUser(chat) {
      return isSignedIn() &&
        chat.data.participants != null &&
        (chat.data.participants is list) &&
        (chat.data.participants.hasAny([request.auth.uid]));
    }

    function canAccessChat(chatId) {
      return isAdmin() ||
        (isSignedIn() &&
          exists(/databases/$(database)/documents/chats/$(chatId)) &&
          chatParticipantsIncludeUser(
            get(/databases/$(database)/documents/chats/$(chatId)),
          ));
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /chats/{chatId} {
      allow read: if isAdmin() || chatParticipantsIncludeUser(resource);

      allow create: if isAdmin() ||
        requestIncludesUser(request.resource.data.participants);

      allow update: if isAdmin() ||
        (chatParticipantsIncludeUser(resource) &&
          requestIncludesUser(request.resource.data.participants));

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if canAccessChat(chatId);

        allow create: if canAccessChat(chatId) &&
          request.resource.data.keys().hasAny(['senderId']) &&
          (isAdmin() || request.resource.data.senderId == request.auth.uid);

        allow update, delete: if isAdmin() ||
          (isSignedIn() && resource.data.senderId == request.auth.uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}